{
  "name": "@rub1cc/pi-apply-patch",
  "version": "1.0.0",
  "description": "Codex-compatible apply_patch tool with rich diff rendering for Pi",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./renderer": "./renderer/index.ts"
  },
  "files": [
    "index.ts",
    "executor.ts",
    "filesystem.ts",
    "parser.ts",
    "types.ts",
    "renderer/**/*.ts",
    "README.md"
  ],
  "scripts": {
    "build": "echo 'TypeScript source is loaded directly by Pi'",
    "check": "bun test",
    "test": "bun test"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "apply-patch",
    "diff"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
